{
  "name": "fichada-app",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:test": "npx eas-cli build -p android --profile preview-test",
    "build:prod": "npx eas-cli build -p android --profile production",
    "update:test": "EXPO_PUBLIC_API_URL=https://fichada.sda.ovh/api npx eas-cli update --branch preview-test --message",
    "update:prod": "EXPO_PUBLIC_API_URL=https://fichada.sda.ovh/api npx eas-cli update --branch production --message"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "lucide-react-native": "^1.20.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  }
}
